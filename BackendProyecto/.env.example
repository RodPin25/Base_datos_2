# =============================================================================
# CONFIGURACIÓN LOCAL DE LA BASE DE DATOS (SQL Server - Plantilla Local)
# =============================================================================
DB_DRIVER="ODBC Driver 17 for SQL Server"
DB_SERVER="localhost"
DB_PORT="1433"
DB_NAME="ProyectoFinal"
DB_USER="sa"
DB_PASSWORD="Password123*"
DB_TRUST_CERTIFICATE="yes"

# Cadena de conexión ODBC completa para entorno local
# (Si se deja vacía, db.py la construye automáticamente usando las variables DB_* de arriba)
DATABASE_URL="DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost,1433;DATABASE=ProyectoFinal;UID=sa;PWD=Password123*;TrustServerCertificate=yes;"

# =============================================================================
# CONFIGURACIÓN LOCAL DE DJANGO Y JWT
# =============================================================================
DEBUG="True"
SECRET_KEY="django-insecure-local-dev-secret-key-proyectofinal"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
ALLOWED_HOSTS="localhost,127.0.0.1,*"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"
