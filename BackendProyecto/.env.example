# =============================================================================
# CONFIGURACIÓN DE LA BASE DE DATOS (SQL Server)
# =============================================================================
# Driver instalado en el contenedor Docker: "ODBC Driver 18 for SQL Server" o "ODBC Driver 17 for SQL Server"
DB_DRIVER="ODBC Driver 18 for SQL Server"

# Host del servidor de base de datos:
# - En máquina local: "localhost" o "127.0.0.1"
# - En servidor Docker usando --network host: "localhost"
# - En servidor Docker usando red bridge por defecto: "172.17.0.1" (gateway de Docker hacia el host)
DB_SERVER="localhost"
DB_PORT="1433"
DB_NAME="ProyectoFinal"
DB_USER="sa"
DB_PASSWORD="tu_password_aqui"
DB_TRUST_CERTIFICATE="yes"

# Cadena de conexión ODBC completa opcional
# (Si se deja vacía, db.py la construye automáticamente usando las variables DB_* de arriba)
DATABASE_URL=""

# =============================================================================
# CONFIGURACIÓN DE DJANGO Y JWT
# =============================================================================
DEBUG="True"
SECRET_KEY="tu_secret_key_aqui_para_produccion"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
ALLOWED_HOSTS="localhost,127.0.0.1,*"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"
